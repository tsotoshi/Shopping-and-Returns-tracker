# Copy this file to .env and fill in values. .env is git-ignored — never commit it.
PORT=3000
# Where the SQLite database file lives (created automatically)
DB_PATH=./data/tracker.sqlite

# Optional: set a password to open the app from your phone on the same Wi-Fi.
# Without it, the app only accepts connections from this computer.
# APP_PASSWORD=choose-something-long

# Stage 2 — Gmail (from Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Stage 3 — AI policy review (from console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Stage 4 — optional
# Address your phone uses to open the app, so notifications can link back to it
# APP_URL=http://192.168.1.20:3000
# Email reminders via your email provider's SMTP (not via the read-only Gmail connection)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password-from-your-provider
# NOTIFY_EMAIL_TO=you@example.com
# Turn off background sync/reminders entirely
# DISABLE_BACKGROUND=1
